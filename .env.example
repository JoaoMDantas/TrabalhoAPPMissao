# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=projeto_missionario
DB_NAME_TEST=projeto_missionario_test
# Fuso horário usado nas datas da agenda (São Luís = -03:00)
DB_TIMEZONE=-03:00

# Autenticação: use um valor longo e aleatório (mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# Administrador criado automaticamente ao iniciar o servidor
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=Admin@12345
