{
  "name": "projeto-missionario",
  "version": "0.3.0",
  "description": "Aplicativo (PWA) para conectar igrejas e missionários",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node database/migrate.js && node database/criar-admin.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node database/migrate.js",
    "db:reset": "node database/migrate.js --reset && node database/criar-admin.js",
    "pretest": "node database/migrate.js --test --reset",
    "test": "node --test"
  },
  "keywords": [
    "igrejas",
    "missionarios",
    "pwa",
    "express",
    "mysql"
  ],
  "author": "João Marcos Coelho Dantas do Nascimento",
  "private": true,
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
